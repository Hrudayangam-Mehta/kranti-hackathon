+#[inline(always)]
+unsafe fn fused_region<const N: usize, const SPLIT: usize, K: Kernel, F: Lines<N>>(p: *const u8, len: usize, on_line: &mut F) {
+    let mut pos = 0usize;
+    while pos < len {
+        let q = p.add(pos);
+        let (c0, n0, q0) = K::masks(q);
+        if SPLIT >= N {
