+
+pub const NAMES: [&str; 16] = [
+    "setup", "links", "events", "clicks", "wait_links", "wait_events", "unmap", "dedup", "bar_dedup", "order",
+    "people", "user_write", "campaign", "last_write", "wait_jobs", "release",
+];
