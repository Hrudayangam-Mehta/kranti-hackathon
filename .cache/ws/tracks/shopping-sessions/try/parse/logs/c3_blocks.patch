+/// Records per sink block: about half of what one thread is expected to write to one
+/// partition, so that the partly filled last block of every (thread, partition) wastes
+/// little memory (and page zeroing) when many threads share the input.
+fn block_for(records: usize, threads: usize, bits: u32, max: usize) -> usize {
+    let per = (records / threads) >> bits;
+    (per / 2).next_power_of_two().clamp(64, max)
+}
