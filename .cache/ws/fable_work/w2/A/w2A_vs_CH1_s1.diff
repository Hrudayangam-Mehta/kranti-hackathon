+    inc('beamHeldForGun')
+    return true
+  }
+  // ------------------------------------------------------------------ HF11: a beam leaves
+  function onRelease(tgt, lz) {
+    const me = B.me, t = me.t
+    if (tgt && !tgt.npc && P.fiSave === true) {
