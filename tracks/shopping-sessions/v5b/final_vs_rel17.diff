+const WIN_BATCH: usize = 32;
+
+struct Winners<'a> {
+    people: &'a People,
+    bits: u32,
+    ring: [[(u64, u64, u32, u32); WIN_BATCH]; 3],
+    slots: [[usize; WIN_BATCH]; 3],
+    lens: [usize; 3],
+    cur: usize,
+    count: usize,
+    total: usize,
+}
+
+impl<'a> Winners<'a> {
+    fn new(people: &'a People, bits: u32) -> Winners<'a> {
+        Winners {
+            people,
+            bits,
+            ring: [[(0, 0, 0, 0); WIN_BATCH]; 3],
+            slots: [[0; WIN_BATCH]; 3],
+            lens: [0; 3],
+            cur: 0,
+            count: 0,
+            total: 0,
+        }
+    }
