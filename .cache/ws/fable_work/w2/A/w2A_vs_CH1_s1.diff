+    const dx = me.x - tgt.x, dy = me.y - tgt.y, d = Math.hypot(dx, dy)
+    if (d < 1) return false
+    const close = (dx * (tgt.vx - me.vx) + dy * (tgt.vy - me.vy)) / d
+    if (close < P.fiSnapV) return false
