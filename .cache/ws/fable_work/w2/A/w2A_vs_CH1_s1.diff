+    if (g.ammo > (near ? P.fiReloadAmmo : P.fiReloadFar)) return false
+    inc('earlyReloads')
+    return true
+  }
+
+  return { pre, yawGate, pitGate, gunNote, save, onRelease, forceS, snap, laserRungs, fullLead, reloadNow, st }
+}
