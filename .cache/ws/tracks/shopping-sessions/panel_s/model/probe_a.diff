+            .env("SESSIONS_REHEARSAL", "1")
+            .env("OUTPUT_DIR", PathBuf::from(&scratch).join(format!("rehearsal{pass}")))
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .status();
+    }
+}
 
