+fn split_tail(units: &mut Vec<(&'static [u8], usize, usize)>, count: usize, pieces: usize) {
+    let from = units.len().saturating_sub(count);
+    let tail: Vec<_> = units.drain(from..).collect();
+    for (file, s, e) in tail {
+        let step = (e - s).div_ceil(pieces).max(1);
+        let mut at = s;
+        while at < e {
+            let next = (at + step).min(e);
+            units.push((file, at, next));
+            at = next;
+        }
+    }
+}
+
+#[inline]
+fn next_line(file: &[u8], at: usize) -> usize {
+    match file[at..].iter().position(|&b| b == b'\n') {
+        Some(offset) => at + offset + 1,
+        None => file.len(),
+    }
+}
+
+fn populate(file: &'static [u8], s: usize, e: usize) {
+    let page = 4096usize;
+    let base = file.as_ptr() as usize;
+    let from = (base + s) & !(page - 1);
+    let to = (base + e.min(file.len())).div_ceil(page) * page;
+    unsafe { libc::madvise(from as *mut libc::c_void, to - from, 22) };
+}
+
+fn line_range(file: &'static [u8], s: usize, e: usize) -> &'static [u8] {
+    populate(file, s, e);
+    let begin = next_line(file, s.saturating_sub(1));
+    let end = if e >= file.len() { file.len() } else { next_line(file, e - 1) };
+    if begin >= end {
+        &file[..0]
+    } else {
+        &file[begin..end]
+    }
+}
+
+fn block_for(records: usize, parts: usize, threads: usize, low: usize) -> usize {
+    (records / (parts * threads * 4)).clamp(low, 512) & !3
+}
+
 fn bits_for(records: usize, per_part: usize) -> u32 {
     let parts = (records / per_part).max(1).next_power_of_two();
     parts.trailing_zeros().clamp(4, 14)
 }
 
+fn category_slot(name: &[u8]) -> usize {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for &b in name {
+        h = (h ^ u64::from(b)).wrapping_mul(0x100_0000_01b3);
+    }
+    (h >> 54) as usize
+}
+
+type ProductTable = (Vec<&'static [u8]>, Vec<(u64, u32)>, u32);
+
+struct CategoryNames {
+    names: Vec<&'static [u8]>,
+    slots: [u16; 1024],
+}
+
+impl CategoryNames {
+    #[inline(always)]
+    fn raw(&mut self, name: &[u8]) -> Option<u32> {
+        let mut slot = category_slot(name);
+        loop {
+            let at = self.slots[slot];
+            if at == u16::MAX {
+                if self.names.len() == 255 {
+                    return None;
+                }
+                self.slots[slot] = self.names.len() as u16;
+                self.names.push(Box::leak(name.to_vec().into_boxed_slice()));
+                return Some(self.names.len() as u32 - 1);
+            }
+            if self.names[at as usize] == name {
+                return Some(u32::from(at));
+            }
+            slot = (slot + 1) & 1023;
+        }
+    }
+}
+
+struct ProductLines<'a, K> {
+    names: &'a mut CategoryNames,
+    entries: &'a mut Vec<(u64, u32)>,
+    full: bool,
+    kernel: std::marker::PhantomData<K>,
+}
+
+impl<K: Kernel> Lines<2> for ProductLines<'_, K> {
+    #[inline(always)]
+    fn line(&mut self, f: &[&[u8]; 2]) {
+        match self.names.raw(f[1]) {
+            Some(raw) => self.entries.push((unsafe { intern_k::<K>(f[0]) }, raw)),
+            None => self.full = true,
+        }
+    }
+}
+
+#[inline(always)]
+unsafe fn product_lines<K: Kernel>(body: &[u8], names: &mut CategoryNames, entries: &mut Vec<(u64, u32)>) -> bool {
+    let mut scratch = Scratch::new();
+    let mut lines = ProductLines::<K> {
+        names,
+        entries,
+        full: false,
+        kernel: std::marker::PhantomData,
+    };
+    scan::scan::<2, K, _>(body, &mut scratch, &mut lines);
+    !lines.full
+}
+
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2,bmi1,bmi2,popcnt")]
+unsafe fn product_lines_avx2(body: &[u8], names: &mut CategoryNames, entries: &mut Vec<(u64, u32)>) -> bool {
+    product_lines::<Avx2>(body, names, entries)
+}
+
+fn product_table(file: &[u8]) -> Option<ProductTable> {
+    let mut names = CategoryNames {
+        names: Vec::new(),
+        slots: [u16::MAX; 1024],
+    };
+    names.raw(UNKNOWN_CATEGORY)?;
+    let mut entries: Vec<(u64, u32)> = Vec::with_capacity(file.len() / 12 + 16);
+    for (start, end) in csv::data_chunks(file, usize::MAX) {
+        let body = &file[start..end];
+        #[cfg(target_arch = "x86_64")]
+        if scan::has_avx2() {
+            if !unsafe { product_lines_avx2(body, &mut names, &mut entries) } {
+                return None;
+            }
+            continue;
+        }
+        if !unsafe { product_lines::<Scalar>(body, &mut names, &mut entries) } {
+            return None;
+        }
+    }
+    let names = names.names;
+    let mut order: Vec<u32> = (0..names.len() as u32).collect();
+    order.sort_unstable_by(|&a, &b| names[a as usize].cmp(names[b as usize]));
+    let mut rank = vec![0u32; names.len()];
+    for (position, &raw) in order.iter().enumerate() {
+        rank[raw as usize] = position as u32;
+    }
+    for entry in entries.iter_mut() {
+        entry.1 = rank[entry.1 as usize];
+    }
+    let categories: Vec<&'static [u8]> = order.iter().map(|&raw| names[raw as usize]).collect();
+    Some((categories, entries, rank[0]))
+}
