+    #[test]
+    fn flatten_matches() {
+        let mut state = 0x9e37_79b9_7f4a_7c15u64;
+        for round in 0..200_000u32 {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            let bits = match round % 4 {
+                0 => state,
+                1 => state & (state >> 7),
+                2 => state & (state >> 3) & (state >> 11),
+                _ => !(state & (state >> 5)),
+            };
+            let mut a = [0u32; 64 + 16];
+            let n = unsafe { flatten(a.as_mut_ptr(), bits, round) };
+            assert_eq!(n, bits.count_ones() as usize);
+            let expected: Vec<u32> = (0..64).filter(|i| bits >> i & 1 == 1).map(|i| round + i).collect();
+            assert_eq!(&a[..n], &expected[..]);
+            #[cfg(target_arch = "x86_64")]
+            if has_avx512() {
+                let mut b = [0u32; 64 + 16];
+                let m = unsafe { Avx512::flatten(b.as_mut_ptr(), bits, round) };
+                assert_eq!(&b[..m], &expected[..]);
+            }
+        }
     }
 
