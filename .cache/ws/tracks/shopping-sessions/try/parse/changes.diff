+/// AVX-512 (F, BW, VBMI2) kernel: one 64-byte compare per delimiter into a mask register,
+/// and `vpcompressb` to turn a comma mask into positions without a bit loop.
+#[cfg(target_arch = "x86_64")]
+pub struct Avx512;
+
+#[cfg(target_arch = "x86_64")]
+impl Kernel for Avx512 {
+    #[inline(always)]
+    unsafe fn masks(p: *const u8) -> (u64, u64, u64) {
+        masks_avx512(p)
+    }
+
+    #[inline(always)]
+    unsafe fn pack(p: *const u8, len: usize) -> Option<u64> {
+        pack_avx2(p, len)
+    }
+
+    #[inline(always)]
+    unsafe fn flatten(out: *mut u32, bits: u64, base: u32) -> usize {
+        flatten_avx512(out, bits, base)
+    }
+}
+
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2,bmi1,bmi2,popcnt,avx512f,avx512bw,avx512vbmi2")]
+#[inline]
+unsafe fn masks_avx512(p: *const u8) -> (u64, u64, u64) {
+    let v = _mm512_loadu_si512(p as *const _);
+    (
+        _mm512_cmpeq_epi8_mask(v, _mm512_set1_epi8(b',' as i8)),
+        _mm512_cmpeq_epi8_mask(v, _mm512_set1_epi8(b'\n' as i8)),
+        _mm512_cmpeq_epi8_mask(v, _mm512_set1_epi8(b'"' as i8)),
+    )
+}
+
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2,bmi1,bmi2,popcnt,avx512f,avx512bw,avx512vbmi2")]
+#[inline]
+unsafe fn flatten_avx512(out: *mut u32, bits: u64, base: u32) -> usize {
+    let count = bits.count_ones() as usize;
+    let iota = _mm512_set_epi64(
+        0x3f3e_3d3c_3b3a_3938,
+        0x3736_3534_3332_3130,
+        0x2f2e_2d2c_2b2a_2928,
+        0x2726_2524_2322_2120,
+        0x1f1e_1d1c_1b1a_1918,
+        0x1716_1514_1312_1110,
+        0x0f0e_0d0c_0b0a_0908,
+        0x0706_0504_0302_0100,
+    );
+    let index = _mm512_maskz_compress_epi8(bits, iota);
+    let b = _mm512_set1_epi32(base as i32);
+    let low = _mm512_cvtepu8_epi32(_mm512_castsi512_si128(index));
+    _mm512_storeu_si512(out as *mut _, _mm512_add_epi32(low, b));
+    if count > 16 {
+        flatten_avx512_rest(out, index, b, count);
+    }
+    count
+}
+
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2,bmi1,bmi2,popcnt,avx512f,avx512bw,avx512vbmi2")]
+#[cold]
+unsafe fn flatten_avx512_rest(out: *mut u32, index: __m512i, b: __m512i, count: usize) {
+    let groups = [
+        _mm512_extracti32x4_epi32::<1>(index),
+        _mm512_extracti32x4_epi32::<2>(index),
+        _mm512_extracti32x4_epi32::<3>(index),
+    ];
+    for (k, group) in groups.iter().enumerate() {
+        if count <= 16 * (k + 1) {
+            break;
+        }
+        let positions = _mm512_add_epi32(_mm512_cvtepu8_epi32(*group), b);
+        _mm512_storeu_si512(out.add(16 * (k + 1)) as *mut _, positions);
+    }
+}
