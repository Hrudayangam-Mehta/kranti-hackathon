+        .map(|p| {
+            let n: usize = all_p2.iter().map(|s| s.len(p)).sum::<usize>()
+                + all_clicks.iter().map(|s| s.len(p)).sum::<usize>() / 4;
+            (n, p)
+        })
+        .collect();
+    sizes.sort_unstable_by(|a, b| b.cmp(a));
+    sizes.into_iter().map(|(_, p)| p).collect()
