+        let mut next = || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            state
+        };
+        for _ in 0..3000 {
+            let len = (next() % 300) as usize;
+            let file: Vec<u8> = (0..len)
+                .map(|_| if next() % 5 == 0 { b'\n' } else { b'a' + (next() % 3) as u8 })
+                .collect();
+            let target = 1 + (next() % 40) as usize;
+            let n = part_count(&file, target) as usize;
+            let mut joined = Vec::new();
+            for k in 0..n {
+                let bytes = part_bytes(&file, k, n, target);
+                if !bytes.is_empty() {
+                    let at = bytes.as_ptr() as usize - file.as_ptr() as usize;
+                    assert!(at == 0 || file[at - 1] == b'\n');
+                    assert!(at + bytes.len() == file.len() || bytes[bytes.len() - 1] == b'\n');
+                }
+                joined.extend_from_slice(bytes);
+            }
+            let expected: Vec<u8> = csv::data_chunks(&file, usize::MAX)
+                .iter()
+                .flat_map(|&(a, b)| file[a..b].to_vec())
+                .collect();
+            assert_eq!(joined, expected, "{:?} {}", String::from_utf8_lossy(&file), target);
+        }
+    }
+}
