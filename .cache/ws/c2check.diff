+            let l = n0.trailing_zeros();
+            let m = (1u64 << l) - 1;
+            let c = c0 & m;
+            let qt = q0 & m;
+            let (bad, qs) = quotes(c, c | (1u64 << l), qt);
+            if (c.count_ones() == (N - 1) as u32) & (l > 0) & (bad == 0) {
+                let mut fields: [&[u8]; N] = [&[]; N];
+                take(q, c, l, qs, &mut fields);
+                on_line.line(&fields);
+            }
