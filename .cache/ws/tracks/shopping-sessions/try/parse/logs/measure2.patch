+/// (user, system) CPU time of the calling thread in nanoseconds.
+fn thread_cpu_ns() -> (usize, usize) {
+    let mut r: libc::rusage = unsafe { std::mem::zeroed() };
+    unsafe { libc::getrusage(libc::RUSAGE_THREAD, &mut r) };
+    let ns = |t: libc::timeval| t.tv_sec as usize * 1_000_000_000 + t.tv_usec as usize * 1000;
+    (ns(r.ru_utime), ns(r.ru_stime))
+}
+
+fn add_cpu(stats: &Stats, phase: usize, from: (usize, usize), to: (usize, usize)) {
+    stats.cpu_ns[2 * phase].fetch_add(to.0 - from.0, Ordering::Relaxed);
+    stats.cpu_ns[2 * phase + 1].fetch_add(to.1 - from.1, Ordering::Relaxed);
 }
 
